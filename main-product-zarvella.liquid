<section id="ZarvellaProduct-{{ section.id }}" class="zv-product"><div class="zv-product__inner"><div class="zv-product__copy"><span class="zv-product__eyebrow">ZARVELLA</span><h1>{{ product.title | escape }}</h1><div class="zv-product__description">{{ product.description }}</div><a class="zv-product__shop" href="#ZVBuy-{{ section.id }}">Shop this look <span>›</span></a><div class="zv-product__social">✦ &nbsp; ZARVELLA &nbsp; ✦ &nbsp; MORE THAN JUST SHOPPING</div></div><div class="zv-product__media">{% assign zv_variant = product.selected_or_first_available_variant %}{% if product.featured_media %}<div class="zv-product__image-wrap">{{ product.featured_media | image_url: width: 1200 | image_tag: class: 'zv-product__image', loading: 'eager', widths: '500,700,900,1200' }}</div>{% endif %}<div class="zv-product__media-caption">MORE THAN JUST SHOPPING</div></div><div class="zv-product__buy" id="ZVBuy-{{ section.id }}"><div class="zv-product__price" data-zv-price>{{ zv_variant.price | money }}</div>{% if zv_variant.compare_at_price > zv_variant.price %}<div class="zv-product__compare" data-zv-compare>{{ zv_variant.compare_at_price | money }}</div>{% else %}<div class="zv-product__compare" data-zv-compare hidden></div>{% endif %}{% assign zv_form_id = 'ZVProductForm-' | append: section.id %}{% form 'product', product, id: zv_form_id, class: 'zv-form' %}<input type="hidden" name="id" value="{{ zv_variant.id }}" data-zv-variant-id>{% unless product.has_only_default_variant %}{% for option in product.options_with_values %}<fieldset class="zv-option"><legend>{{ option.name }}</legend><div class="zv-option__values">{% for value in option.values %}{% assign zv_id = 'zv-' | append: section.id | append: '-' | append: option.position | append: '-' | append: forloop.index %}<input class="zv-option__input" type="radio" id="{{ zv_id }}" name="zv-option-{{ option.position }}" value="{{ value | escape }}" data-option-position="{{ option.position }}" {% if option.selected_value == value %}checked{% endif %}><label class="zv-option__pill" for="{{ zv_id }}">{{ value }}</label>{% endfor %}</div></fieldset>{% endfor %}{% endunless %}<div class="zv-quantity"><label for="ZVQty-{{ section.id }}">Quantity</label><div class="zv-quantity__box"><button type="button" data-zv-minus aria-label="Decrease quantity">−</button><input id="ZVQty-{{ section.id }}" type="number" name="quantity" value="1" min="1"><button type="button" data-zv-plus aria-label="Increase quantity">+</button></div></div><button type="submit" class="zv-add" {% unless zv_variant.available %}disabled{% endunless %} data-zv-add>{% if zv_variant.available %}ADD TO CART{% else %}SOLD OUT{% endif %}</button><div class="zv-buy-now">{{ form | payment_button }}</div>{% endform %}</div></div><script type="application/json" data-zv-variants>{{ product.variants | json }}</script></section><style>#ZarvellaProduct-{{ section.id }}{background:#090909;position:relative;overflow:hidden;color:#fff}#ZarvellaProduct-{{ section.id }}:before{content:"";position:absolute;inset:0;background-image:radial-gradient(circle at 18% 20%,rgba(212,164,65,.55) 0 1px,transparent 2px),radial-gradient(circle at 78% 12%,rgba(212,164,65,.45) 0 1px,transparent 2px),radial-gradient(circle at 65% 72%,rgba(212,164,65,.35) 0 1px,transparent 2px),radial-gradient(circle at 28% 78%,rgba(212,164,65,.35) 0 1px,transparent 2px);background-size:210px 180px,260px 220px,300px 240px,240px 210px;opacity:.5;pointer-events:none}#ZarvellaProduct-{{ section.id }} .zv-product__inner{position:relative;z-index:1;max-width:1440px;margin:0 auto;min-height:680px;padding:70px 6vw;display:grid;grid-template-columns:1fr 1.25fr 1fr;align-items:center;gap:48px}#ZarvellaProduct-{{ section.id }} h1{font-family:Georgia,serif;font-size:clamp(38px,4vw,68px);line-height:1.05;margin:12px 0 22px;color:#fff}#ZarvellaProduct-{{ section.id }} .zv-product__eyebrow{color:#d9aa4d;letter-spacing:.28em;font-size:12px}#ZarvellaProduct-{{ section.id }} .zv-product__description{color:#ddd;font-size:15px;line-height:1.7;max-width:360px}#ZarvellaProduct-{{ section.id }} .zv-product__description p{margin:0 0 12px}#ZarvellaProduct-{{ section.id }} .zv-product__shop{display:inline-flex;gap:24px;align-items:center;margin-top:28px;background:#fff;color:#111;border-radius:30px;padding:12px 22px;text-decoration:none;font-size:13px}#ZarvellaProduct-{{ section.id }} .zv-product__shop span{font-size:22px;line-height:0}#ZarvellaProduct-{{ section.id }} .zv-product__social{margin-top:90px;color:#aaa;font-size:10px;letter-spacing:.08em}#ZarvellaProduct-{{ section.id }} .zv-product__media{text-align:center}#ZarvellaProduct-{{ section.id }} .zv-product__image-wrap{display:flex;align-items:center;justify-content:center;min-height:430px}#ZarvellaProduct-{{ section.id }} .zv-product__image{max-width:100%;width:auto;max-height:480px;object-fit:contain;filter:drop-shadow(0 28px 25px rgba(0,0,0,.75))}#ZarvellaProduct-{{ section.id }} .zv-product__media-caption{font-family:Georgia,serif;font-size:24px;line-height:1.2;color:#eee;margin-top:8px}#ZarvellaProduct-{{ section.id }} .zv-product__buy{padding-left:12px}#ZarvellaProduct-{{ section.id }} .zv-product__price{font-family:Georgia,serif;font-size:34px;color:#fff}#ZarvellaProduct-{{ section.id }} .zv-product__compare{font-size:18px;color:#999;text-decoration:line-through;margin-top:4px}#ZarvellaProduct-{{ section.id }} .zv-option{border:0;padding:0;margin:28px 0 0}#ZarvellaProduct-{{ section.id }} .zv-option legend{font-size:12px;color:#ddd;margin-bottom:12px}#ZarvellaProduct-{{ section.id }} .zv-option__values{display:flex;flex-wrap:wrap;gap:10px}#ZarvellaProduct-{{ section.id }} .zv-option__input{position:absolute;opacity:0;pointer-events:none}#ZarvellaProduct-{{ section.id }} .zv-option__pill{display:flex;align-items:center;justify-content:center;min-width:48px;height:48px;padding:0 14px;border-radius:50px;background:#111;border:1px solid #555;color:#fff;font-size:12px;cursor:pointer}#ZarvellaProduct-{{ section.id }} .zv-option__input:checked + .zv-option__pill{background:#fff;color:#111;border-color:#fff}#ZarvellaProduct-{{ section.id }} .zv-quantity{margin-top:24px}#ZarvellaProduct-{{ section.id }} .zv-quantity>label{display:block;font-size:12px;color:#ddd;margin-bottom:9px}#ZarvellaProduct-{{ section.id }} .zv-quantity__box{display:flex;align-items:center;width:132px;border:1px solid #555;border-radius:28px;overflow:hidden}#ZarvellaProduct-{{ section.id }} .zv-quantity__box button{width:38px;height:40px;background:transparent;color:#fff;border:0;font-size:20px;cursor:pointer}#ZarvellaProduct-{{ section.id }} .zv-quantity__box input{width:56px;height:40px;background:transparent;color:#fff;border:0;text-align:center;-moz-appearance:textfield}#ZarvellaProduct-{{ section.id }} .zv-quantity__box input::-webkit-inner-spin-button{appearance:none}#ZarvellaProduct-{{ section.id }} .zv-add{width:100%;margin-top:22px;border:1px solid #d9aa4d;background:#d9aa4d;color:#090909;border-radius:3px;padding:16px 20px;font-size:12px;font-weight:700;letter-spacing:.16em;cursor:pointer}#ZarvellaProduct-{{ section.id }} .zv-add:disabled{opacity:.45;cursor:not-allowed}#ZarvellaProduct-{{ section.id }} .zv-buy-now{margin-top:10px}#ZarvellaProduct-{{ section.id }} .shopify-payment-button__button{min-height:50px!important;border-radius:3px!important}@media(max-width:900px){#ZarvellaProduct-{{ section.id }} .zv-product__inner{grid-template-columns:1fr;gap:28px;padding:44px 22px;min-height:0}#ZarvellaProduct-{{ section.id }} .zv-product__copy{order:1}#ZarvellaProduct-{{ section.id }} .zv-product__media{order:2}#ZarvellaProduct-{{ section.id }} .zv-product__buy{order:3;padding-left:0}#ZarvellaProduct-{{ section.id }} .zv-product__social{margin-top:35px}#ZarvellaProduct-{{ section.id }} .zv-product__image-wrap{min-height:300px}#ZarvellaProduct-{{ section.id }} .zv-product__image{max-height:360px}}</style><script>(function(){const root=document.getElementById('ZarvellaProduct-{{ section.id }}');if(!root)return;const variants=JSON.parse(root.querySelector('[data-zv-variants]').textContent);const idInput=root.querySelector('[data-zv-variant-id]');const price=root.querySelector('[data-zv-price]');const compare=root.querySelector('[data-zv-compare]');const add=root.querySelector('[data-zv-add]');const money=(c)=>new Intl.NumberFormat('{{ localization.language.iso_code }}',{style:'currency',currency:'{{ cart.currency.iso_code }}'}).format(c/100);function selected(){const vals={};root.querySelectorAll('.zv-option__input:checked').forEach(i=>vals[i.dataset.optionPosition]=i.value);return variants.find(v=>v.options.every((o,i)=>!vals[i+1]||vals[i+1]===o))||variants.find(v=>v.available)||variants[0]}function sync(){const v=selected();if(!v)return;idInput.value=v.id;price.textContent=money(v.price);if(v.compare_at_price&&v.compare_at_price>v.price){compare.hidden=false;compare.textContent=money(v.compare_at_price)}else{compare.hidden=true}add.disabled=!v.available;add.textContent=v.available?'ADD TO CART':'SOLD OUT';if(v.featured_image){const img=root.querySelector('.zv-product__image');if(img)img.src=v.featured_image.src}}root.querySelectorAll('.zv-option__input').forEach(i=>i.addEventListener('change',sync));const qty=root.querySelector('.zv-quantity__box input');root.querySelector('[data-zv-minus]')?.addEventListener('click',()=>qty.value=Math.max(1,(+qty.value||1)-1));root.querySelector('[data-zv-plus]')?.addEventListener('click',()=>qty.value=(+qty.value||1)+1);sync()})();</script>{% schema %}{"name":"Zarvella Product","settings":[]}{% endschema %}