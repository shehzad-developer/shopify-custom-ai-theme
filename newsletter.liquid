<section class='zv-newsletter'><div class='zv-newsletter-inner'><div class='zv-newsletter-icon'>✉</div><h2>Join Our Community</h2><p>Get exclusive offers, new arrivals and more.</p>{% form 'customer', id: 'ContactFooter', class: 'zv-newsletter-form' %}{% if form.posted_successfully? %}<p class='zv-success'>Thank you for subscribing!</p>{% endif %}{{ form.errors | default_errors }}<input type='hidden' name='contact[tags]' value='newsletter'><input type='email' name='contact[email]' required autocomplete='email' placeholder='Enter your email address' aria-label='Email address'><button type='submit'>SUBSCRIBE</button>{% endform %}</div></section><style>.zv-newsletter{background:#0d1016;padding:72px 20px 90px;text-align:center}.zv-newsletter-inner{max-width:620px;margin:0 auto}.zv-newsletter-icon{width:70px;height:70px;border:1px solid #c9a85f;border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 26px;color:#fff;font-size:18px}.zv-newsletter h2{margin:0 0 14px;color:#fff!important;font-size:34px;line-height:1.2;font-weight:500}.zv-newsletter p{color:#aaa;margin:0 0 28px;font-size:16px}.zv-newsletter-form{display:flex;flex-direction:column;gap:10px}.zv-newsletter-form input[type=email]{width:100%;height:72px;padding:0 24px;border:1px solid #ddd;background:#fff;color:#111;font-size:18px;box-sizing:border-box}.zv-newsletter-form button{width:100%;height:74px;border:0;background:#c9a85f;color:#111;font-size:18px;cursor:pointer}.zv-success{color:#c9a85f!important}.zv-newsletter .errors{color:#fff;background:#7b1e1e;padding:10px;margin:0 0 10px}</style>