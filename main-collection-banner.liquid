{% comment %} ZARVELLA collection banner + circular subcategories restored from Original, using current Main Menu links. {% endcomment %}
{%- style -%}.collection-subcategory-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px 14px;margin-top:28px}.collection-subcategory-card{text-align:center;text-decoration:none;color:inherit;display:block}.collection-subcategory-card__image{width:100%;aspect-ratio:1/1;border-radius:50%;overflow:hidden;background:#f4f4f4;display:flex;align-items:center;justify-content:center;margin:0 auto 10px}.collection-subcategory-card__image img{width:100%;height:100%;object-fit:cover;display:block}.collection-subcategory-card__name{font-size:14px;line-height:1.3;letter-spacing:.02em}@media screen and (min-width:750px){.collection-subcategory-grid{grid-template-columns:repeat(4,minmax(0,1fr));gap:24px 18px}.collection-subcategory-card__name{font-size:15px}}@media screen and (min-width:990px){.collection-subcategory-grid{grid-template-columns:repeat(6,minmax(0,1fr))}}{%- endstyle -%}
